# Required environment variables for production

# Phoenix secret key base — generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Path to the SQLite database file (must be writable by the app process)
DATABASE_PATH=/data/phaeton.db

# Public hostname of the application (no scheme, no port)
PHX_HOST=example.com

# Set to "true" to start the web server (always true when using Dockerfile CMD)
PHX_SERVER=true

# Port to listen on (default: 4000)
PORT=4000

# SQLite connection pool size (default: 5)
POOL_SIZE=5
